LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_MAX_TOKENS=4096
# Backend allowlist exposed to the UI; no live provider model fetch.
LLM_ALLOWED_MODELS=gemini/gemini-3.5-flash-lite,openai/gpt-5.4-mini

OPENAI_API_KEY=
GEMINI_API_KEY=your_gemini_api_key_here

# Binance Demo Trading. Create these keys in Binance Demo and keep them local.
BINANCE_API_ENV=demo
BINANCE_CLI_PATH=binance-cli
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Local troubleshooting only. Debug logs may contain prompts and request bodies.
LITELLM_DEBUG=false
